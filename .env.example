# AI Memory RAG 配置文件

# 向量数据库配置
VECTOR_STORE_TYPE=chroma
CHROMA_PATH=./chroma_db
# 如果使用 Pinecone，请取消下面的注释并填写你的 API Key
# VECTOR_STORE_TYPE=pinecone
# PINECONE_API_KEY=your-pinecone-api-key
# PINECONE_ENV=your-pinecone-environment
# PINECONE_INDEX=ai-memory-rag

# 关系数据库配置
RELATIONAL_STORE_TYPE=sqlite
DATABASE_URL=sqlite:///./ai-memory-rag.db
# 如果使用 PostgreSQL，请取消下面的注释
# RELATIONAL_STORE_TYPE=postgresql
# DATABASE_URL=postgresql://user:pass@localhost:5432/ai_memory_rag

# 嵌入模型配置
EMBEDDING_MODEL=all-MiniLM-L6-v2

# API 配置
API_HOST=0.0.0.0
API_PORT=8000

# UI 配置
UI_HOST=0.0.0.0
UI_PORT=8501
